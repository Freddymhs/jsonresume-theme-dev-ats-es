{
  "name": "@fmarcosdev/jsonresume-theme-dev-ats-es",
  "version": "1.0.8",
  "description": "Tema JSONResume compatible con ATS para desarrolladores",
  "keywords": [
    "jsonresume",
    "jsonresume-theme",
    "json",
    "resume",
    "theme",
    "cv",
    "es"
  ],
  "author": "Freddy Huaylla",
  "repository": {
    "type": "git",
    "url": "https://github.com/Freddymhs/jsonresume-theme-dev-ats-es"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "resumed serve --theme .",
    "export": "resumed export -F --theme . --resume ../fmarcosdev.api.resume/resume.json resume.pdf",
    "local-test": "resumed export -F --theme . --resume ../fmarcosdev.api.resume/resume.json --format html resume-preview.html && xdg-open resume-preview.html"
  },
  "dependencies": {
    "address-format": "0.0.3",
    "handlebars": "^4.7.8",
    "handlebars-wax": "^6.1.0",
    "moment": "^2.30.1",
    "swag": "^0.7.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^13.1.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "resumed-cli": "^2.1.9",
    "semantic-release": "^24.2.3"
  },
  "volta": {
    "node": "24.11.0"
  },
  "overrides": {
    "@semantic-release/npm": "^13.1.0"
  }
}
